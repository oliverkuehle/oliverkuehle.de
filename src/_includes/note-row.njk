{%- macro noteRow(note) -%}
<li class="row">
  <span class="row__meta">
    <span>{% if note.data.ongoing %}Ongoing{% else %}{{ note.date | monthYear }}{% endif %}</span>
  </span>
  <span class="row__title">
    {%- if note.data.redirect %}
    <a href="{{ note.data.redirect }}" target="_blank" rel="noopener noreferrer">{{ note.data.title }}</a>
    <span class="msr open_in_new">open_in_new</span>
    {%- elif note.url %}
    <a href="{{ note.url }}">{{ note.data.title }}</a>
    {%- else %}
    {{ note.data.title }}
    {%- endif %}
  </span>
</li>
{%- endmacro -%}
